# Copy to .env and fill in.  Free setup = Groq (chat) + FastEmbed (local embeddings).

# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# LLM: groq | openai     Embeddings: fastembed (free, local) | openai
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=fastembed

# Optional model overrides (defaults: openai/gpt-oss-120b / BAAI/bge-small-en-v1.5)
CHAT_MODEL=openai/gpt-oss-120b
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Only needed if you switch a provider to openai
# OPENAI_API_KEY=sk-...

COMPANY_NAME=Acme Corp

# Retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE=0.3

# Optional: point at your own folders
# DOCS_DIR=D:/company-docs
# NOTION_EXPORT_DIR=D:/notion-export

# Optional: Confluence (pip install atlassian-python-api beautifulsoup4)
# CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
# CONFLUENCE_USERNAME=you@yourcompany.com
# CONFLUENCE_API_KEY=...
# CONFLUENCE_SPACE_KEY=HR
